rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Profils utilisateurs
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // ✅ NOUVEAU : Autoriser l'accès à la sous-collection 'choices'
      // Indispensable pour que .collection('choices').add() fonctionne
      match /choices/{choiceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ✅ NOUVELLE RÈGLE : Autoriser l'accès à 'favorite_details'
      match /favorite_details/{programId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ✅ NOUVELLE RÈGLE : Autoriser l'accès à 'ai_suggestions'
      match /ai_suggestions/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ✅ Notifications : lecture par le propriétaire, écriture par tout utilisateur authentifié
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null;
      }
    }
    
    // Entraide Académique (règles existantes conservées)
    match /academic_needs/{needId} {
      allow read, write: if request.auth != null;
    }
  }
}
